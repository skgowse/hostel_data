<%- include('../layouts/header') %>

<!-- Fee Cycles & Due Date Management Hub -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                <i class="bi bi-calendar3-range me-1"></i>Administration Hub
            </span>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                <i class="bi bi-clock-history me-1"></i>Calculated as of: <%= todayFormatted %>
            </span>
        </div>
        <h3 class="fw-bold text-dark mb-1">Fee Cycles & Due Date Management</h3>
        <p class="text-muted small mb-0">Manage student billing cycles, verify payment receipts, or directly mark offline / cash payments as completed</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/student-add" class="btn btn-primary btn-sm shadow-sm fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Add Student
        </a>
        <a href="/admin/export" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
    </div>
</div>

<!-- KPI Summary Cards (Clickable for Instant Filtering) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card stat-card border-0 shadow-sm rounded-3 p-3 kpi-clickable-card h-100" data-filter-status="OVERDUE" title="Click to filter Overdue Payments">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small text-muted fw-bold">Overdue Payments</span>
                <div class="stat-icon bg-danger-subtle text-danger rounded-3 p-2">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                </div>
            </div>
            <div class="stat-value text-danger fs-3 fw-bold" id="kpiOverdueCount">0</div>
            <div class="small text-muted mt-1">Students past cycle due date</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card stat-card border-0 shadow-sm rounded-3 p-3 kpi-clickable-card h-100" data-filter-status="DUE_TODAY" title="Click to filter Due Today">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small text-muted fw-bold">Due Today</span>
                <div class="stat-icon bg-warning-subtle text-warning-emphasis rounded-3 p-2">
                    <i class="bi bi-bell-fill"></i>
                </div>
            </div>
            <div class="stat-value text-warning-emphasis fs-3 fw-bold" id="kpiDueTodayCount">0</div>
            <div class="small text-muted mt-1">Due today exactly</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card stat-card border-0 shadow-sm rounded-3 p-3 kpi-clickable-card h-100" data-filter-status="DUE_7_DAYS" title="Click to filter Due within 7 Days">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small text-muted fw-bold">Due in 7 Days</span>
                <div class="stat-icon bg-info-subtle text-info rounded-3 p-2">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
            </div>
            <div class="stat-value text-info fs-3 fw-bold" id="kpiDue7DaysCount">0</div>
            <div class="small text-muted mt-1">Upcoming within a week</div>
        </div>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-funnel-fill text-primary me-2"></i>Filter Students by Due Date & Cycle Status</h5>
            <p class="text-muted small mb-0">Displaying students ordered by joining date in ascending order</p>
        </div>
        <div>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="resetFiltersBtn">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
            </button>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label for="ajaxStatusSelect" class="form-label fw-bold small text-muted">Due Date Status</label>
                <select class="form-select" id="ajaxStatusSelect">
                    <option value="ALL">All Active Students</option>
                    <option value="OVERDUE">Overdue Payments</option>
                    <option value="DUE_TODAY">Due Today</option>
                    <option value="DUE_7_DAYS">Due Within 7 Days</option>
                    <option value="DUE_30_DAYS">Due Within 30 Days</option>
                    <option value="PENDING">Pending Verification</option>
                    <option value="COMPLETED">Completed Payments</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label for="ajaxServiceSelect" class="form-label fw-bold small text-muted">Service Type</label>
                <select class="form-select" id="ajaxServiceSelect">
                    <option value="ALL">All Services</option>
                    <option value="MESS">Mess Only</option>
                    <option value="HOSTEL">Hostel Only</option>
                    <option value="BOTH">Mess + Hostel</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="ajaxFromDueDate" class="form-label fw-bold small text-muted">Due From Date</label>
                <input type="date" class="form-control" id="ajaxFromDueDate">
            </div>
            <div class="col-6 col-md-2">
                <label for="ajaxToDueDate" class="form-label fw-bold small text-muted">Due To Date</label>
                <input type="date" class="form-control" id="ajaxToDueDate">
            </div>
            <div class="col-12 col-md-3">
                <label for="ajaxSearchInput" class="form-label fw-bold small text-muted">Search Student / UTR</label>
                <div class="input-group">
                    <span class="input-group-text bg-body-tertiary"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" id="ajaxSearchInput" placeholder="Name, code, mobile...">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating Bulk Action Bar -->
<div id="bulkActionBar" class="bulk-action-bar d-none shadow-lg rounded-4 p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3 border bg-body">
    <div class="d-flex align-items-center gap-3">
        <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill" id="selectedStudentsCount">0 Students Selected</span>
        <span class="fw-bold font-monospace text-success fs-5" id="selectedStudentsTotalAmount">Total: ₹0.00</span>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="clearSelectionBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Selection
        </button>
        <button type="button" class="btn btn-success btn-sm fw-bold shadow-sm" id="openBulkPayModalBtn">
            <i class="bi bi-cash-stack me-1"></i> Mark All Selected as Paid
        </button>
    </div>
</div>

<!-- Students Dynamic Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <h5 class="fw-bold mb-0">Student Billing Cycles & Status</h5>
            <span class="badge bg-primary-subtle text-primary border" id="matchCountBadge">0 Students</span>
        </div>
        <div id="filterLoadingIndicator" class="spinner-border spinner-border-sm text-primary d-none" role="status"></div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 40px;">
                        <input type="checkbox" class="form-check-input" id="selectAllStudentsCheckbox" title="Select / Deselect All">
                    </th>
                    <th>Actions</th>
                    <th>Student Name</th>
                    <th>Mobile</th>
                    <th>Joining Date</th>
                    <th>Current Cycle Interval</th>
                    <th>Due Date</th>
                    <th>Fee</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="studentFeeStatusTbody">
                <tr>
                    <td colspan="9" class="text-center py-5 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2"></div>Loading student records...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Bulk Mark as Paid -->
<div class="modal fade" id="bulkPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <form id="bulkPaymentForm">
                <div class="modal-header bg-success text-white border-0 py-3">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cash-coin me-2"></i>Bulk Record Payments (Mark Selected Paid)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info-subtle border-0 rounded-3 p-3 mb-3 small">
                        <i class="bi bi-info-circle-fill text-info me-1"></i>
                        You are about to mark active cycles as <strong>COMPLETED</strong> for <strong id="bulkModalCount">0</strong> selected student(s).
                    </div>

                    <div class="table-responsive mb-3 border rounded-3" style="max-height: 200px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Code</th>
                                    <th>Student</th>
                                    <th>Cycle</th>
                                </tr>
                            </thead>
                            <tbody id="bulkModalStudentList" class="small"></tbody>
                        </table>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="bulkPayMethod" class="form-label fw-bold">Payment Method</label>
                            <select class="form-select" id="bulkPayMethod" required>
                                <option value="CASH" selected>Cash (Paid at Warden Office)</option>
                                <option value="UPI">UPI / QR Code</option>
                                <option value="BANK_TRANSFER">Bank Transfer / NEFT</option>
                                <option value="OTHER">Other Offline Mode</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="bulkPayDate" class="form-label fw-bold">Date of Payment</label>
                            <input type="date" class="form-control" id="bulkPayDate" value="<%= todayFormatted.split('-').reverse().join('-') %>">
                        </div>
                        <div class="col-12">
                            <label for="bulkPayNotes" class="form-label fw-bold">Batch Notes / Reference</label>
                            <input type="text" class="form-control" id="bulkPayNotes" placeholder="Optional batch description">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4 fw-semibold" id="confirmBulkPayBtn">
                        <i class="bi bi-check-circle-fill me-1"></i> Confirm & Mark All Paid
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
